            "state" : "translated",
            "value" : "Бинауральное воспроизведение приостановлено, так как наушники были отключены."
          }
        }
      }
    },
    "Binaural voices work best with stereo headphones; speaker playback reduces the binaural effect." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binaural voices work best with stereo headphones; speaker playback reduces the binaural effect."
