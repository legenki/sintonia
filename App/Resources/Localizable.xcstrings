    "20-minute dip from 12 -> 4.5 Hz Theta followed by an invigorating rise to 14 Hz.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "20-minute dip from 12 -> 4.5 Hz Theta followed by an invigorating rise to 14 Hz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "20-минутное погружение 12 → 4.5 Гц (Тета) с мягким бодрящим подъёмом обратно к 14 Гц."
          }
        }
      }
    },
    "45-minute deep Delta 2.5 -> 1.2 Hz drift with deep brown noise and 5-minute gradual fade-out.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "45-minute deep Delta 2.5 -> 1.2 Hz drift with deep brown noise and 5-minute gradual fade-out."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "45-минутный глубокий дрейф Дельта 2.5 → 1.2 Гц с глубоким коричневым шумом и 5-минутным затуханием."
          }
        }
      }
    },
