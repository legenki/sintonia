    "BWG Compatibility Note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WaveForge imports classic BrainWave Generator (.bwg) text presets locally. External WAV backgrounds and visual strobe flags are safely skipped with a report."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WaveForge локально импортирует классические текстовые пресеты BrainWave Generator (.bwg). Внешние WAV-фоны и флаги визуальной стимуляции безопасно пропускаются с отчётом."
          }
        }
      }
