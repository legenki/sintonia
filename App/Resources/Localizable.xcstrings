    "Automation & Offline Export Detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shape frequency and volume envelopes across the entire session and export faster than real time to 24-bit WAV or 256 kbps M4A."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраивайте огибающие частот и громкости на всём протяжении сессии и экспортируйте в 24-битный WAV или M4A (256 кбит/с) быстрее реального времени."
          }
        }
      }
    },
